set shell := ["bash", "-uc"]

local := "/home/abaisero/git/stable-baselines3-causal-vr/"
default-server := "blarg"

rsync-flags := "--mkpath \
    -avz \
    --exclude='.git' \
    --exclude='__pycache__' \
    --exclude='*.pyc' \
    --exclude='runs' \
    --exclude='wandb' \
    --exclude='.mypy_cache' \
    --exclude='.ruff_cache' \
    --exclude='.pytest_cache' \
    --exclude='*.egg-info'"

default:
    @just --list

# Push local -> remote. Adds new files, updates modified ones. Does not delete remote-only files.
push server="$default-server":
    #!/usr/bin/env bash
    set -e
    target=$(./servers-lookup.sh {{ server }})
    just _push "$target"

# Preview what `push` would change on the remote, without writing anything.
push-dry server="$default-server":
    #!/usr/bin/env bash
    set -e
    target=$(./servers-lookup.sh {{ server }})
    just _push "$target" --dry-run --itemize-changes

_push target *flags:
    rsync {{ rsync-flags }} {{ flags }} {{ local }} {{ target }}
